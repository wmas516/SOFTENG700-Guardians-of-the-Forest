[node name="Dialog" parent="HUD" unique_id=445186671 instance=ExtResource("11_p4iqy")]
speaker = "Myrtle King"
text = "Well well kaimanaki you have come so far to stop me but this is where your quest ends. prepair yourself for a swift demise."
